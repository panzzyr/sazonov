---
layout: layouts/base.njk
---
<article class="prose">
  <header class="page-heading">
    <p class="eyebrow">{{ "Статья" if lang == "ru" else "Post" }}</p>
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ date | isoDate }}">{{ date | isoDate }}</time>
      <span aria-hidden="true">·</span>
      {{ content | readingTime }} {{ "мин чтения" if lang == "ru" else "min read" }}
      {% if tags %}<span aria-hidden="true">·</span> {{ tags | join(", ") }}{% endif %}
    </p>
  </header>
  <div class="prose-body">{{ content | safe }}</div>
  <nav class="back-link" aria-label="{{ 'Назад' if lang == 'ru' else 'Back' }}">
    <a href="{{ '/ru/posts/' if lang == 'ru' else '/posts/' }}">← {{ "Статьи" if lang == "ru" else "Posts" }}</a>
  </nav>
</article>
