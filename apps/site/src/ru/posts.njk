---
layout: layouts/base.njk
title: Статьи
description: Заметки о вычислительной физике, симуляциях, веб-инструментах и продюсировании.
lang: ru
section: posts
permalink: /ru/posts/
translationUrl: /posts/
englishUrl: /posts/
---
<header class="page-heading">
  <p class="eyebrow">Индекс</p>
  <h1>Статьи</h1>
</header>
<section class="index-section prose-body" aria-label="Статьи">
  {% set posts = collections.posts | whereLang("ru") %}
  {% if posts.length %}
    <ul class="index-list">
      {% for post in posts %}
        <li>
          <a href="{{ post.url }}">{{ post.data.title }}</a>
          <time datetime="{{ post.date | isoDate }}">{{ post.date | isoDate }}</time>
          <p class="description">{{ post.data.description }}</p>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty">Опубликованных статей пока нет.</p>
  {% endif %}
</section>
