---
permalink: /ru/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }} — статьи</title>
  <subtitle>Заметки о вычислительной физике, симуляциях и инструментах.</subtitle>
  <link href="{{ '/ru/feed.xml' | absoluteUrl(site.url) }}" rel="self"/>
  <link href="{{ '/ru/' | absoluteUrl(site.url) }}"/>
  <id>{{ '/ru/' | absoluteUrl(site.url) }}</id>
  <updated>{% if collections.posts.length %}{{ collections.posts[0].date.toISOString() }}{% else %}2026-07-29T00:00:00.000Z{% endif %}</updated>
  {% for post in collections.posts | whereLang("ru") %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ post.url | absoluteUrl(site.url) }}"/>
    <id>{{ post.url | absoluteUrl(site.url) }}</id>
    <updated>{{ post.date.toISOString() }}</updated>
    <summary>{{ post.data.description }}</summary>
    <content type="html"><![CDATA[{{ post.templateContent | safe }}]]></content>
  </entry>
  {% endfor %}
</feed>
