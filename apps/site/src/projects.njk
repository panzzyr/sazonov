---
layout: layouts/base.njk
title: Projects
description: Research, engineering, and production projects by Stepan Sazonov.
lang: en
section: projects
permalink: /projects/
translationUrl: /ru/projects/
englishUrl: /projects/
---
<header class="page-heading">
  <p class="eyebrow">Selected work</p>
  <h1>Projects</h1>
</header>
<section class="index-section prose-body" aria-label="Projects">
  <ul class="index-list">
    {% for project in collections.projects | whereLang("en") %}
      <li>
        <a href="{{ project.url }}">{{ project.data.title }}</a>
        <time>{{ project.data.year }}</time>
        <p class="description">{{ project.data.description }}</p>
      </li>
    {% endfor %}
  </ul>
</section>
